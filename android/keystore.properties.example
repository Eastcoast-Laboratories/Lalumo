# Copy this file to keystore.properties and fill in your values.
# keystore.properties is gitignored and must NOT be committed.
#
# The upload keystore is used to sign release APKs/AABs for Google Play.
# Google re-signs with the app signing key (managed by Google Play App Signing).

uploadStoreFile=/home/USER/android-keystore/upload-keystore.jks
uploadStorePassword=YOUR_KEYSTORE_PASSWORD_HERE
uploadKeyAlias=key0
uploadKeyPassword=YOUR_KEY_PASSWORD_HERE
