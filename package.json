{
  "name": "lalumo",
  "version": "5.4",
  "versionCode": 35,
  "description": "Child-friendly music understanding app",
  "main": "index.js",
  "scripts": {
    "sync-strings": "mkdir -p public/android/app/src/main/res/values public/android/app/src/main/res/values-de && cp android/app/src/main/res/values/strings.xml public/android/app/src/main/res/values/ && cp android/app/src/main/res/values-de/strings.xml public/android/app/src/main/res/values-de/",
    "watch": "npm run sync-strings && webpack serve --mode development",
    "build": "npm run sync-strings && webpack --mode production",
    "build:fast": "npm run sync-strings && webpack --mode development"
  },
  "keywords": [
    "music",
    "children",
    "education"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@playwright/test": "^1.47.2",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.0",
    "js-yaml": "^4.1.0",
    "loader-utils": "^3.3.1",
    "mini-css-extract-plugin": "^2.9.1",
    "node-html-parser": "^6.1.13",
    "style-loader": "^4.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "yaml-loader": "^0.8.1"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.3",
    "alpinejs": "^3.14.1",
    "tone": "^15.0.4"
  }
}
