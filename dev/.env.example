# Local Mac-build environment for dev/macos-build-setup.sh and
# dev/plans/ios-build-scaleway.md.
# Copy this file to dev/.env and fill in real values — dev/.env is
# gitignored (the .env pattern in .gitignore covers it).

# SSH target of the Scaleway Mac mini (user@host, key auth)
MAC_HOST=m1@x.x.x.x

# Repo checkout on the Mac — tilde expands on the remote side
MAC_REPO='~/repos/Lalumo'

# Laptop-side file containing the Mac login password, used for
# "security unlock-keychain". Read it into a variable, never echo it.
MAC_PASSWORT_FILE=/path/to/mac-mini-passwort.txt

# This repo's checkout on the laptop (rsync source, ipa destination)
LOCAL_REPO=/var/www/lalumo

# Apple Developer team ID and App Store Connect app id
APPLE_TEAM_ID=XXXXXXXXXX
ASC_APP_ID=0000000000

# Where the downloaded App Store .mobileprovision sits on the laptop
# (one-time copy into dev/xcode/)
PROV_PROFILE_SRC=/path/to/Lalumo_AppStore.mobileprovision
