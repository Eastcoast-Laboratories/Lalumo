# Deployment configuration for lalumo.eu
# Copy this file to .env and fill in the real values.
# .env is ignored by git and must not be committed.

SERVER_IP=your.server.ip
SSHPORT=22
SSH_USER=root
SSH_PATH=/opt/user/www/lalumo.eu/www/
GIT_PATH=/opt/user/git/lalumo.z11.de/
FPM_USERNAME=fpm-pool-user
FPM_GROUP=customer-group
